<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OverjoyedVersion3.ToggleButton">
    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
        <HorizontalStackLayout.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </HorizontalStackLayout.GestureRecognizers>
        <Label x:Name="StateLabel" Text="Off" VerticalOptions="Center" FontSize="{DynamicResource SubtextFontSize}"/>
        <Border x:Name="Capsule" WidthRequest="44" HeightRequest="24" StrokeThickness="2" Padding="3"
                HorizontalOptions="Start" VerticalOptions="Center">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="9999"/>
            </Border.StrokeShape>
            <Grid>
                <Ellipse x:Name="Circle" WidthRequest="14" HeightRequest="14" HorizontalOptions="Start"
                         VerticalOptions="Center"/>
            </Grid>
        </Border>
    </HorizontalStackLayout>
</ContentView>
