<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OverjoyedVersion3.IconButton">
    <Border x:Name="InnerBorder" StrokeThickness="0" HorizontalOptions="Start">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped"/>
        </Border.GestureRecognizers>
        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
            <Image x:Name="ButtonImage" WidthRequest="{DynamicResource IconSize}" HeightRequest="{DynamicResource IconSize}"
                   Aspect="AspectFit" VerticalOptions="Center"/>
            <Label x:Name="ButtonLabel" TextColor="{DynamicResource FontColor}" VerticalOptions="Center" FontSize="{DynamicResource SubtextFontSize}"/>
        </HorizontalStackLayout>
    </Border>
</ContentView>
