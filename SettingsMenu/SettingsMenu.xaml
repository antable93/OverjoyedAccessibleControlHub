<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:overjoyed="clr-namespace:OverjoyedVersion3"
             x:Class="OverjoyedVersion3.SettingsMenu">

    <Grid ColumnDefinitions="1*, 1*, 8*, 1*" BackgroundColor="{DynamicResource OverlayColor}" Padding="20">
        <VerticalStackLayout Spacing="1" Grid.Column="0" BackgroundColor="Transparent" VerticalOptions="Start" 
                             HorizontalOptions="Fill">
            
            <overjoyed:IconButton x:Name="EditorButton" BackgroundColor="Transparent" Padding="5, 5, 0, 5" 
                                  WidthRequest="225" IconSource="gamepad" Text="Controller Editor"
                                  FontSize="{DynamicResource BodyFontSize}" IconSize="{DynamicResource IconSize}" Rounded="True" Clicked="OnEditorButtonClicked"/>
            <overjoyed:IconButton x:Name="AppearanceButton" BackgroundColor="Transparent" Padding="5, 5, 0, 5" 
                                  WidthRequest="225" IconSource="paint-roller" Text="Appearance"
                                  FontSize="{DynamicResource BodyFontSize}" IconSize="{DynamicResource IconSize}" Rounded="True" Clicked="OnAppearanceButtonClicked"/>
            <overjoyed:IconButton x:Name="WindowOptionsButton" BackgroundColor="Transparent" Padding="5, 5, 0, 5" 
                                  WidthRequest="225" IconSource="options" Text="Window Options"
                                  FontSize="{DynamicResource BodyFontSize}" IconSize="{DynamicResource IconSize}" Rounded="True" Clicked="OnWindowOptionsButtonClicked"/>
            <overjoyed:IconButton x:Name="DevicesButton" BackgroundColor="Transparent" Padding="5, 5, 0, 5" 
                                  WidthRequest="225" IconSource="mouse" Text="Devices"
                                  FontSize="{DynamicResource BodyFontSize}" IconSize="{DynamicResource IconSize}" Rounded="True" Clicked="OnDevicesButtonClicked"/>
        </VerticalStackLayout>

        <ContentView x:Name="SubMenuContainer" Grid.Column="2" VerticalOptions="Start"/>
    </Grid>

</ContentView>
