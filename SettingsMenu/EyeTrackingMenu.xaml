<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OverjoyedVersion3.EyeTrackingMenu">
    <Grid RowDefinitions="Auto, Auto, *" RowSpacing="12">
        <Label Text="Eye Tracking" FontSize="{DynamicResource TitleFontSize}"
               FontAttributes="Bold" TextColor="{DynamicResource FontColor}"/>
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" ColumnSpacing="12">
            <Label x:Name="StatusLabel" Text="Loading local eye tracker..." VerticalOptions="Center"
                   FontSize="{DynamicResource BodyFontSize}" TextColor="{DynamicResource FontColor}"/>
            <Button x:Name="ReloadButton" Grid.Column="1" Text="Reload tracker" Clicked="OnReloadClicked"
                    FontSize="{DynamicResource BodyFontSize}"/>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource PanelBackground}">
            <WebView x:Name="TrackerWebView"
                     HorizontalOptions="Fill" VerticalOptions="Fill"/>
        </Border>
    </Grid>
</ContentView>
